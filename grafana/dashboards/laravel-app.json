{
  "title": "Laravel Application Monitoring",
  "uid": "laravel-app",
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "title": "App Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "expr": "laravel_app_uptime_seconds", "legendFormat": "Uptime (s)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "continuous-grn-rd" }
        }
      }
    },
    {
      "title": "Memory Usage",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        { "expr": "laravel_app_memory_bytes", "legendFormat": "Memory" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "continuous-blw" }
        }
      }
    },
    {
      "title": "Database Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        { "expr": "laravel_app_database_up", "legendFormat": "Database" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-grn-rd" },
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      }
    },
    {
      "title": "Storage Usage",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        { "expr": "laravel_app_storage_used_percent", "legendFormat": "Storage" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 60, "color": "yellow" }, { "value": 85, "color": "red" }] }
        }
      }
    },
    {
      "title": "Request Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        { "expr": "laravel_app_requests_total", "legendFormat": "Requests" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-blw" }
        }
      }
    },
    {
      "title": "Avg Response Time",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        { "expr": "laravel_app_response_time_ms", "legendFormat": "Response (ms)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 200, "color": "yellow" }, { "value": 500, "color": "red" }] }
        }
      }
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "tags": ["laravel", "prometheus", "monitoring"],
  "schemaVersion": 38
}
